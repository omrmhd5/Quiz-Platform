# Demo environment — copy values into Vercel. Do not commit real secrets.

# Reuse the existing Neon project (quiz-platform). Pooled URL for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# New demo cookie secret (32+ characters). Do not copy production.
SESSION_SECRET=replace-with-32-plus-character-demo-secret

# Optional override for student join links in production (defaults to current host).
LAN_HOST=

# Seed credentials used by `npm run seed:demo`
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=teacher123
